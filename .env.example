# Copy to .env and fill in at least one key. The rotating client skips any
# backend whose key is absent, so one key is enough to run.
#
# Groq is the default because it is fast and free-tier generous, which matters
# once experiment sweeps reach thousands of calls.
GROQ_API_KEY=

# Optional additional backends for rotation under rate limits.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
